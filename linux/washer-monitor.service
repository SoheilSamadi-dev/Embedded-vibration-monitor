[Unit]
Description=Washing machine activity detector
After=nicla-logger.service network-online.target
Wants=nicla-logger.service network-online.target

[Service]
Type=exec
User=YOUR_USER
Environment=HOME=/home/YOUR_USER
WorkingDirectory=/home/YOUR_USER/embedded-condition-monitor
ExecStart=/usr/bin/python3 -u /home/YOUR_USER/embedded-condition-monitor/washer_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
UMask=0077

[Install]
WantedBy=multi-user.target
